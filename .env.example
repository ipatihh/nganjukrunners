# Pendaftaran anggota (Google Apps Script) — sudah ada sebelumnya.
GOOGLE_SCRIPT_URL=

# ─── Merchandise lewat KEMBAR.IN (docs/INTEGRASI_KEMBARIN.md) ──────────────────
# Kode event berjenis Merchandise di dashboard KEMBAR.IN. Kosong = katalog tidak tampil.
KEMBAR_IN_MERCH_EVENT_CODE=

# Asal core. Produksi: https://kembar.in. Uji lokal: http://localhost:3000.
KEMBAR_IN_BASE_URL=https://kembar.in

# Kunci partner: HARUS sama dengan secret `nganjukrunners:<secret>` di TRUSTED_PARTNER_KEYS
# core. Tanpa kunci, pesanan tetap bisa dibuat, tetapi pembeli dipulangkan ke kembar.in
# setelah bayar dan batas laju dihitung per IP server situs ini.
KEMBAR_IN_PARTNER_KEY=

# Asal situs ini — tujuan kembali setelah bayar (/katalog/status). Host-nya harus sama
# dengan tautan "Tiket dijual di" event Merchandise di KEMBAR.IN.
NEXT_PUBLIC_SITE_URL=https://www.nganjukrunners.or.id
